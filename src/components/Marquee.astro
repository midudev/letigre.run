---
interface Props {
  /** Textos que se repiten en la cinta */
  items: string[]
  /** Duración de una vuelta completa */
  duration?: string
  reverse?: boolean
  /** Inclinación en grados */
  tilt?: number
  variant?: 'solid' | 'ghost'
  class?: string
}

const {
  items,
  duration = '28s',
  reverse = false,
  tilt = 0,
  variant = 'solid',
  class: className = ''
} = Astro.props

// Dos grupos idénticos, cada uno de al menos el ancho de la pantalla: la
// animación desplaza un grupo entero, así la cinta nunca deja hueco.
const groups = [0, 1]

// Repetir los textos dentro de cada grupo evita que `justify-around` tenga
// espacio de sobra que repartir y separe las frases en pantallas anchas.
const repeated = [items, items, items].flat()
---

{/* La cinta inclinada tiene que ser más ancha que la pantalla para que no se
     destapen las esquinas, así que sobresale por los lados. Este envoltorio
     recorta ese exceso: `overflow-x: clip` corta a lo ancho sin tocar el alto,
     que la rotación necesita libre. Sin él, el sobrante genera scroll lateral. */}
<div class:list={['relative overflow-x-clip', className]}>
  <div
    class:list={[
      'marquee',
      variant === 'solid' ? 'marquee--solid' : 'marquee--ghost',
      tilt !== 0 && '-mx-[6%] w-[112%]'
    ]}
    style={`transform: rotate(${tilt}deg);`}
  >
    {
      groups.map((groupIndex) => (
        <div
          class:list={[
            'marquee__track',
            reverse ? 'animate-marquee-reverse' : 'animate-marquee'
          ]}
          style={`--marquee-duration: ${duration};`}
          aria-hidden={groupIndex === 1 ? 'true' : undefined}
        >
          {repeated.map((item) => (
            <span class="marquee__item">
              <span class="marquee__text">{item}</span>
              <span aria-hidden="true" class="marquee__dot" />
            </span>
          ))}
        </div>
      ))
    }
  </div>
</div>
