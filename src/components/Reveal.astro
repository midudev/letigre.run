---
interface Props {
  /**
   * Escalona la entrada dentro de una lista: `0` entra primero, `1` un poco
   * después, etc. Se traduce a un retraso del rango de scroll, porque
   * `animation-delay` no tiene efecto en las animaciones ligadas al scroll.
   */
  order?: number
  as?: 'div' | 'li' | 'section' | 'article' | 'span'
  class?: string
}

const { order = 0, as: Tag = 'div', class: className = '' } = Astro.props

// Escalón más generoso (5% por ítem) para que el cascade se lea al bajar.
// Tope del 20%: más allá el último de una lista larga entraría demasiado tarde.
const shift = Math.min(order * 5, 20)
---

<Tag
  class:list={['reveal', className]}
  style={shift ? `--reveal-shift: ${shift}%;` : undefined}
>
  <slot />
</Tag>
