---
import Reveal from '@/components/Reveal.astro'

interface Props {
  /** Nombre base del clip en `public/videos/web` (sin extensión) */
  name: string
  /** Etiqueta pequeña sobre el título */
  eyebrow: string
  title: string
  description: string
  /** Pegatina que flota sobre el vídeo */
  sticker?: string
  /** Coloca el vídeo a la derecha en pantallas grandes */
  flip?: boolean
  /**
   * Qué parte del encuadre se conserva al recortar a cuadrado en móvil.
   * `bottom` cuando lo importante está en la mitad inferior.
   */
  focus?: 'center' | 'bottom'
}

const {
  name,
  eyebrow,
  title,
  description,
  sticker,
  flip = false,
  focus = 'center'
} = Astro.props

const base = `/videos/web/${name}`
---

<article
  class="grid items-center gap-8 md:grid-cols-2 md:gap-14 lg:gap-20"
  data-scroll-video-section
>
  <Reveal class:list={['relative', flip && 'md:order-2']}>
    <div
      class="relative overflow-hidden rounded-[2rem] border-2 border-brand/40 bg-ink-800 shadow-[0_0_60px_-15px] shadow-brand/30"
    >
      <!-- Cuadrado en móvil: un 9/16 a pantalla completa obliga a scrollear el
           vídeo entero. En tablet y escritorio ya cabe vertical. -->
      <video
        class:list={[
          'aspect-square w-full object-cover sm:aspect-[9/16]',
          focus === 'bottom' ? 'object-bottom sm:object-center' : 'object-center'
        ]}
        poster={`${base}.webp`}
        muted
        loop
        playsinline
        preload="none"
        disablepictureinpicture
        tabindex="-1"
        aria-label={title}
        data-scroll-video
      >
        <!-- WebM primero: pesa la mitad que el MP4 a igual calidad. El MP4
             queda como respaldo para navegadores sin VP9. -->
        <source src={`${base}.webm`} type="video/webm" />
        <source src={`${base}.mp4`} type="video/mp4" />
      </video>

      <!-- Barra de progreso del clip -->
      <div class="absolute inset-x-0 bottom-0 h-1 bg-ink-950/50">
        <div class="h-full w-0 bg-brand" data-video-progress></div>
      </div>
    </div>

    {
      sticker && (
        <span
          class="animate-float absolute -top-4 -right-3 z-10 rounded-full bg-brand px-4 py-2 font-display text-sm text-ink-950 uppercase shadow-lg md:text-base"
        >
          {sticker}
        </span>
      )
    }
  </Reveal>

  <Reveal delay={120} class:list={[flip && 'md:order-1']}>
    <p
      class="font-display text-sm tracking-[0.25em] text-brand uppercase md:text-base"
    >
      {eyebrow}
    </p>

    <h2 class="mt-3 text-4xl text-balance sm:text-5xl lg:text-6xl">
      {title}
    </h2>

    <p class="mt-5 max-w-prose text-base/relaxed text-white/70 md:text-lg/relaxed">
      {description}
    </p>
  </Reveal>
</article>

<script>
  const videos =
    document.querySelectorAll<HTMLVideoElement>('[data-scroll-video]')

  // Cada vídeo arranca al entrar en pantalla y se pausa al salir, así solo se
  // descarga (`preload="none"`) lo que el usuario llega a ver.
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        const video = entry.target as HTMLVideoElement

        if (entry.isIntersecting) {
          video.play().catch(() => {
            // Autoplay bloqueado (p.ej. ahorro de datos): se queda el poster
          })
        } else {
          video.pause()
        }
      }
    },
    { threshold: 0.35 }
  )

  for (const video of videos) {
    observer.observe(video)

    const progress = video
      .closest('[data-scroll-video-section]')
      ?.querySelector<HTMLElement>('[data-video-progress]')

    if (!progress) continue

    video.addEventListener('timeupdate', () => {
      if (!video.duration) return
      progress.style.width = `${(video.currentTime / video.duration) * 100}%`
    })
  }
</script>
