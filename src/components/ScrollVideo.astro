---
import Reveal from '@/components/Reveal.astro'

interface Props {
  /** Nombre base del clip en `public/videos/web` (sin extensión) */
  name: string
  /** Etiqueta pequeña sobre el título */
  eyebrow: string
  title: string
  description: string
  /** Pegatina que flota sobre el vídeo */
  sticker?: string
  /** Coloca el vídeo a la derecha en pantallas grandes */
  flip?: boolean
  /**
   * Qué parte del encuadre se conserva al recortar a cuadrado en móvil.
   * `bottom` cuando lo importante está en la mitad inferior.
   */
  focus?: 'center' | 'bottom'
}

const {
  name,
  eyebrow,
  title,
  description,
  sticker,
  flip = false,
  focus = 'center'
} = Astro.props

const base = `/videos/web/${name}`
const objectPos =
  focus === 'bottom' ? 'object-bottom sm:object-center' : 'object-center'
---

<article
  class="grid items-center gap-8 md:grid-cols-2 md:gap-14 lg:gap-20"
  data-scroll-video-section
>
  <Reveal class:list={['relative', flip && 'md:order-2']}>
    <div
      class="relative overflow-hidden rounded-[2rem] border-2 border-brand/40 bg-ink-800 shadow-[0_0_60px_-15px] shadow-brand/30"
    >
      {/* Cuadrado en móvil: un 9/16 a pantalla completa obliga a scrollear el
           vídeo entero. En tablet y escritorio ya cabe vertical. */}
      {/*
        Poster en capa propia (no el attr `poster` del <video>).
        En Mobile Safari, al llamar play() el poster nativo se quita ANTES de
        pintar el primer frame → flash negro. El <img> se queda encima hasta
        que hay frame real y entonces se funde.
      */}
      <img
        src={`${base}.webp`}
        alt=""
        aria-hidden="true"
        decoding="async"
        draggable="false"
        class:list={[
          'pointer-events-none absolute inset-0 z-10 size-full object-cover transition-opacity duration-300 ease-out',
          objectPos
        ]}
        data-video-poster
      />
      <video
        class:list={[
          'aspect-square w-full bg-transparent object-cover sm:aspect-[9/16]',
          objectPos
        ]}
        muted
        loop
        playsinline
        preload="none"
        disablepictureinpicture
        tabindex="-1"
        aria-label={title}
        data-scroll-video
      >
        {/* Sólo MP4: probado VP9/WebM y a igual tamaño daba peor SSIM que
             x264 con este material (mucho grano y movimiento). */}
        <source src={`${base}.mp4`} type="video/mp4" />
      </video>

      {/* Barra de progreso del clip */}
      <div class="absolute inset-x-0 bottom-0 z-20 h-1 bg-ink-950/50">
        <div class="h-full w-0 bg-brand" data-video-progress></div>
      </div>
    </div>

    {
      sticker && (
        <span
          class="animate-float absolute -top-4 -right-3 z-10 rounded-full bg-brand px-4 py-2 font-display text-sm text-ink-950 uppercase shadow-lg md:text-base"
        >
          {sticker}
        </span>
      )
    }
  </Reveal>

  <Reveal order={1} class:list={[flip && 'md:order-1']}>
    <p
      class="font-display text-sm tracking-[0.25em] text-brand uppercase md:text-base"
    >
      {eyebrow}
    </p>

    <h2 class="mt-3 text-4xl text-balance sm:text-5xl lg:text-6xl">
      {title}
    </h2>

    <p class="mt-5 max-w-prose text-base/relaxed text-white/70 md:text-lg/relaxed">
      {description}
    </p>
  </Reveal>
</article>

<script>
  const videos =
    document.querySelectorAll<HTMLVideoElement>('[data-scroll-video]')

  /** Quita el poster en capa cuando el vídeo ya ha pintado un frame real. */
  function armPosterHandoff(video: HTMLVideoElement) {
    const poster = video.parentElement?.querySelector<HTMLElement>(
      '[data-video-poster]'
    )
    // `arming` evita apilar callbacks si el clip entra/sale del viewport
    // varias veces antes del primer frame.
    if (
      !poster ||
      poster.dataset.handedOff === '1' ||
      poster.dataset.arming === '1'
    ) {
      return
    }
    poster.dataset.arming = '1'

    const handoff = () => {
      if (poster.dataset.handedOff === '1') return
      poster.dataset.handedOff = '1'
      poster.classList.add('opacity-0')
      // Tras el fade el <img> ya no aporta nada; lo sacamos del árbol de capas
      // para que no compita con el vídeo en el compositor de Safari.
      poster.addEventListener(
        'transitionend',
        () => {
          poster.hidden = true
        },
        { once: true }
      )
    }

    // requestVideoFrameCallback = “hay píxeles del vídeo en pantalla”.
    // Fallback: doble rAF tras `playing` para dejar que el compositor pinte.
    const v = video as HTMLVideoElement & {
      requestVideoFrameCallback?: (cb: () => void) => number
    }

    if (typeof v.requestVideoFrameCallback === 'function') {
      v.requestVideoFrameCallback(() => {
        requestAnimationFrame(handoff)
      })
    } else {
      const onPlaying = () => {
        requestAnimationFrame(() => requestAnimationFrame(handoff))
        video.removeEventListener('playing', onPlaying)
      }
      video.addEventListener('playing', onPlaying)
    }
  }

  // Empieza a bajar el MP4 un poco antes de entrar del todo, para que al
  // hacer play el primer frame llegue casi al momento y el handoff sea limpio.
  const warmer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue
        const video = entry.target as HTMLVideoElement
        video.preload = 'auto'
        warmer.unobserve(video)
      }
    },
    { rootMargin: '40% 0px' }
  )

  // Cada vídeo arranca al entrar en pantalla y se pausa al salir.
  const player = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        const video = entry.target as HTMLVideoElement

        if (entry.isIntersecting) {
          armPosterHandoff(video)
          video.play().catch(() => {
            // Autoplay bloqueado (p.ej. ahorro de datos): se queda el poster
          })
        } else {
          video.pause()
        }
      }
    },
    { threshold: 0.35 }
  )

  for (const video of videos) {
    warmer.observe(video)
    player.observe(video)

    const progress = video
      .closest('[data-scroll-video-section]')
      ?.querySelector<HTMLElement>('[data-video-progress]')

    if (!progress) continue

    video.addEventListener('timeupdate', () => {
      if (!video.duration) return
      progress.style.width = `${(video.currentTime / video.duration) * 100}%`
    })
  }
</script>
