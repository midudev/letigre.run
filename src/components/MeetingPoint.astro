---
import Picture from '@/components/Picture.astro'
import { CLUB, LINKS } from '@/consts'
import Reveal from '@/components/Reveal.astro'
---

<section id="donde" class="mx-auto max-w-6xl px-5 py-20 sm:py-28">
  <div class="grid items-center gap-8 md:grid-cols-2 md:gap-14">
    <Reveal>
      <p
        class="font-display text-sm tracking-[0.25em] text-brand uppercase sm:text-base"
      >
        Cómo llegar
      </p>
      <h2 class="mt-3 text-4xl text-balance sm:text-5xl lg:text-6xl">
        Nos vemos en<br />
        <span class="text-brand">la puerta</span>
      </h2>

      <address
        class="mt-6 text-base/relaxed text-white/70 not-italic md:text-lg/relaxed"
      >
        <strong class="font-semibold text-white">{CLUB.meetingPoint}</strong><br
        />
        {CLUB.street}<br />
        {CLUB.postalCode} · {CLUB.city}
      </address>

      <p class="mt-4 text-sm/relaxed text-white/55">
        Estamos en el casco antiguo del Prat, a diez minutos andando de la
        estación de Renfe. Salimos a las {CLUB.time} en punto, así que mejor
        llegar unos minutos antes para el café.
      </p>

      <div class="mt-7 flex flex-col gap-3 sm:flex-row">
        <a
          href={LINKS.directions}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-full bg-brand px-6 py-3.5 font-display text-base text-ink-950 uppercase transition hover:bg-lime-brand-300 active:scale-95"
        >
          <svg
            aria-hidden="true"
            class="size-5 shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M3 11 22 2l-9 19-2-8-8-2Z"></path>
          </svg>
          Cómo llegar
        </a>

        <a
          href={LINKS.maps}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-full border-2 border-brand/50 px-6 py-3.5 font-display text-base text-brand uppercase transition hover:border-brand hover:bg-brand/10 active:scale-95"
        >
          Ver en Google Maps
        </a>
      </div>
    </Reveal>

    <Reveal order={1}>
      <!-- Mapa estático generado con `pnpm map` + `pnpm images`. Antes montaba
           MapLibre (~550 KB) para un mapa que nadie mueve. -->
      <a
        href={LINKS.directions}
        target="_blank"
        rel="noopener noreferrer"
        class="group relative block overflow-hidden rounded-[2rem] border-2 border-brand/40 shadow-[0_0_60px_-15px] shadow-brand/30"
      >
        <Picture
          src="/images/map/map"
          widths={[400, 600, 900, 1200]}
          width={1200}
          height={1200}
          alt={`Mapa del punto de encuentro: ${CLUB.street}, ${CLUB.city}`}
          sizes="(min-width: 768px) 50vw, 100vw"
          class="aspect-square w-full object-cover transition-transform duration-700 group-hover:scale-105"
        />

        <!-- El script del mapa deja el punto en el centro exacto -->
        <span
          class="pointer-events-none absolute top-1/2 left-1/2 grid size-12 -translate-x-1/2 -translate-y-1/2 place-items-center"
        >
          <span
            class="animate-pulse-ring col-start-1 row-start-1 size-12 rounded-full bg-brand/35"
          ></span>
          <span
            class="col-start-1 row-start-1 size-4 rounded-full border-[3px] border-ink-950 bg-brand"
          ></span>
        </span>

        <!-- Crece hacia ARRIBA desde el marcador: hacia abajo se salía del
             recorte del mapa en las pantallas estrechas -->
        <span
          class="pointer-events-none absolute bottom-1/2 left-1/2 mb-7 block w-48 -translate-x-1/2 rounded-2xl border-2 border-brand/55 bg-ink-950/95 p-2.5 shadow-[0_18px_45px_-12px_rgb(0_0_0/0.8)] sm:w-52"
        >
          <!-- Punta del bocadillo, apuntando al pin de debajo -->
          <span
            aria-hidden="true"
            class="absolute bottom-0 left-1/2 z-10 size-3 -translate-x-1/2 translate-y-[calc(50%-1px)] rotate-45 border-r-2 border-b-2 border-brand/55 bg-ink-950"
          ></span>
          <Picture
            src="/images/tienda/tienda"
            widths={[260, 520]}
            width={1448}
            height={1086}
            alt=""
            sizes="200px"
            class="aspect-[4/3] w-full rounded-xl object-cover"
          />
          <span class="mt-2 block font-display text-sm text-brand uppercase">
            {CLUB.meetingPoint}
          </span>
          <span class="mt-0.5 block text-xs/relaxed text-white/60">
            {CLUB.street}<br />
            {CLUB.day} a las {CLUB.time}
          </span>
        </span>
      </a>

      <p class="mt-3 text-center text-[0.7rem] text-white/35">
        Mapa © <a
          href="https://www.openstreetmap.org/copyright"
          target="_blank"
          rel="noopener noreferrer"
          class="underline decoration-white/20 hover:text-white/60"
          >OpenStreetMap</a
        > · Teselas © <a
          href="https://carto.com/attributions"
          target="_blank"
          rel="noopener noreferrer"
          class="underline decoration-white/20 hover:text-white/60">CARTO</a
        >
      </p>
    </Reveal>
  </div>
</section>
