---
import Picture from '@/components/Picture.astro'
import { CLUB, LINKS } from '@/consts'
import Reveal from '@/components/Reveal.astro'
---

<section id="donde" class="section">
  <div class="split">
    <Reveal>
      <p class="eyebrow">Cómo llegar</p>
      <h2 class="heading-section mt-3">
        Nos vemos en<br />
        <span class="text-brand">la puerta</span>
      </h2>

      <address class="lede mt-6 not-italic">
        <strong class="font-semibold text-white">{CLUB.meetingPoint}</strong><br
        />
        {CLUB.street}<br />
        {CLUB.postalCode} · {CLUB.city}
      </address>

      <p class="mt-4 text-sm/relaxed text-white/55">
        Estamos en el casco antiguo del Prat, a diez minutos andando de la
        estación de Renfe. Salimos a las {CLUB.time} en punto, así que mejor
        llegar unos minutos antes para el café.
      </p>

      <div class="mt-7 flex flex-col gap-3 sm:flex-row">
        <a
          href={LINKS.directions}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-brand"
        >
          <svg
            aria-hidden="true"
            class="icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M3 11 22 2l-9 19-2-8-8-2Z"></path>
          </svg>
          Cómo llegar
        </a>

        <a
          href={LINKS.maps}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-outline"
        >
          Ver en Google Maps
        </a>
      </div>
    </Reveal>

    <Reveal order={1}>
      {/* Mapa estático generado con `pnpm map` + `pnpm images`. Antes montaba
           MapLibre (~550 KB) para un mapa que nadie mueve. */}
      <a
        href={LINKS.directions}
        target="_blank"
        rel="noopener noreferrer"
        class="frame-media group block"
      >
        {/* En móvil el pin va más abajo (~72%) para que el tooltip con foto
             quepa encima sin recortarse. El mapa se escala y baja el mismo
             porcentaje para que el punto geográfico siga bajo el pin. En
             `md+` todo vuelve al centro (el script del mapa lo deja ahí). */}
        <Picture
          src="/images/map/map"
          widths={[400, 600, 900, 1200]}
          width={1200}
          height={1200}
          alt={`Mapa del punto de encuentro: ${CLUB.street}, ${CLUB.city}`}
          sizes="(min-width: 768px) 50vw, 100vw"
          class="aspect-square w-full object-cover transition-transform duration-700 max-md:translate-y-[22%] max-md:scale-[1.45] md:group-hover:scale-105"
        />

        <span
          class="pointer-events-none absolute top-[72%] left-1/2 grid size-12 -translate-x-1/2 -translate-y-1/2 place-items-center md:top-1/2"
        >
          <span
            class="animate-pulse-ring col-start-1 row-start-1 size-12 rounded-full bg-brand/35"
          ></span>
          <span
            class="col-start-1 row-start-1 size-4 rounded-full border-[3px] border-ink-950 bg-brand"
          ></span>
        </span>

        {/* Crece hacia ARRIBA desde el marcador: hacia abajo se salía del
             recorte del mapa en las pantallas estrechas */}
        <span
          class="pointer-events-none absolute bottom-[28%] left-1/2 mb-7 block w-48 -translate-x-1/2 rounded-2xl border-2 border-brand/55 bg-ink-950/95 p-2.5 shadow-[0_18px_45px_-12px_rgb(0_0_0/0.8)] sm:w-52 md:bottom-1/2"
        >
          {/* Punta del bocadillo, apuntando al pin de debajo */}
          <span
            aria-hidden="true"
            class="absolute bottom-0 left-1/2 z-10 size-3 -translate-x-1/2 translate-y-[calc(50%-1px)] rotate-45 border-r-2 border-b-2 border-brand/55 bg-ink-950"
          ></span>
          <Picture
            src="/images/tienda/tienda"
            widths={[260, 520]}
            width={1448}
            height={1086}
            alt=""
            sizes="200px"
            class="aspect-[4/3] w-full rounded-xl object-cover"
          />
          <span class="mt-2 block font-display text-sm text-brand uppercase">
            {CLUB.meetingPoint}
          </span>
          <span class="mt-0.5 block text-xs/relaxed text-white/60">
            {CLUB.street}<br />
            {CLUB.day} a las {CLUB.time}
          </span>
        </span>
      </a>

      <p class="mt-3 text-center text-[0.7rem] text-white/35">
        Mapa © <a
          href="https://www.openstreetmap.org/copyright"
          target="_blank"
          rel="noopener noreferrer"
          class="underline decoration-white/20 hover:text-white/60"
          >OpenStreetMap</a
        > · Teselas © <a
          href="https://carto.com/attributions"
          target="_blank"
          rel="noopener noreferrer"
          class="underline decoration-white/20 hover:text-white/60">CARTO</a
        >
      </p>
    </Reveal>
  </div>
</section>
