---
import Picture from '@/components/Picture.astro'
import Reveal from '@/components/Reveal.astro'

// La foto de la fachada no está aquí: ya sale en el bocadillo del mapa
const photos = [
  {
    src: '/images/avion/avion',
    widths: [420, 720, 1080],
    width: 1304,
    height: 1738,
    alt: 'El grupo calentando junto a la pista del aeropuerto mientras aterriza un avión',
    caption: 'Aviones a 100 metros. Ventajas de correr en El Prat.'
  },
  {
    src: '/images/playa/playa',
    widths: [420, 720, 1080],
    width: 1304,
    height: 1738,
    alt: 'Foto de grupo del club en la playa del Prat después de una salida',
    caption: 'Foto de grupo obligatoria. Siempre.'
  },
  {
    src: '/images/tienda-2/tienda-2',
    widths: [720, 1080, 1440],
    width: 1448,
    height: 1086,
    alt: 'Otra foto de grupo del club a la vuelta de la salida, en la puerta de Le Tigré',
    caption: 'Cada sábado somos unos cuantos más.',
    featured: true
  }
]
---

<section class="mx-auto max-w-6xl px-5 pb-20 sm:pb-28">
  <Reveal>
    <h2 class="text-4xl text-balance sm:text-5xl lg:text-6xl">
      Un sábado <span class="text-brand">cualquiera</span>
    </h2>
    <p class="mt-5 max-w-prose text-base/relaxed text-white/70 md:text-lg/relaxed">
      Nos juntamos en la puerta, café, charla y salimos. A la vuelta, croissants
      y foto de grupo.
    </p>
  </Reveal>

  <div class="mt-8 grid gap-4 sm:grid-cols-2">
    {
      photos.map((photo, index) => (
        <Reveal order={index} class={photo.featured ? 'sm:col-span-2' : ''}>
          <figure class="group relative overflow-hidden rounded-3xl border-2 border-brand/25">
            <Picture
              src={photo.src}
              widths={photo.widths}
              width={photo.width}
              height={photo.height}
              alt={photo.alt}
              sizes={
                photo.featured
                  ? '(min-width: 1024px) 1024px, 100vw'
                  : '(min-width: 640px) 50vw, 100vw'
              }
              class:list={[
                'w-full object-cover transition duration-700 group-hover:scale-105',
                photo.featured ? 'aspect-[4/3]' : 'aspect-[4/5]'
              ]}
            />
            <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink-950 via-ink-950/70 to-transparent p-4 pt-12 text-sm text-white/85">
              {photo.caption}
            </figcaption>
          </figure>
        </Reveal>
      ))
    }
  </div>
</section>
