---
import { LINKS } from '@/consts'

interface Props {
  /** `hero` pinta los botones grandes, `inline` los compacta */
  variant?: 'hero' | 'inline'
  class?: string
}

const { variant = 'hero', class: className = '' } = Astro.props

const base =
  'group inline-flex min-w-0 items-center justify-center gap-2 rounded-full font-display uppercase transition active:scale-95'

// El relleno y el cuerpo suben a partir de `sm`: con «Instagram» y su icono, un
// `px-7 text-lg` no cabe en dos columnas en pantallas de 320 px
const sizes =
  variant === 'hero'
    ? 'px-5 py-3.5 text-base sm:px-7 sm:py-4 sm:text-lg'
    : 'px-5 py-3 text-base'

// Strava e Instagram comparten la línea en móvil, de ahí el `flex-1`
const secondary =
  'flex-1 border-2 border-brand/50 text-brand hover:border-brand hover:bg-brand/10 sm:flex-none'
---

<!-- En móvil WhatsApp ocupa toda la línea (es el CTA principal) y Strava e
     Instagram se reparten la siguiente; a partir de `sm` van los tres en fila -->
<div
  class:list={['flex flex-col gap-3 sm:flex-row sm:items-center', className]}
>
  <a
    href={LINKS.whatsapp}
    target="_blank"
    rel="noopener noreferrer"
    class:list={[
      base,
      sizes,
      'bg-brand text-ink-950 hover:bg-lime-brand-300 hover:shadow-[0_0_40px_-8px] hover:shadow-brand'
    ]}
  >
    <svg
      aria-hidden="true"
      class="size-5 shrink-0"
      viewBox="0 0 24 24"
      fill="currentColor"
    >
      <path
        d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21 5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2Zm5.8 14.06c-.24.68-1.4 1.3-1.93 1.35-.53.05-1.02.07-1.75-.11-.42-.1-.97-.28-1.67-.58-2.96-1.28-4.9-4.26-5.05-4.46-.15-.2-1.2-1.6-1.2-3.05s.76-2.16 1.03-2.46c.27-.3.59-.37.79-.37.2 0 .39.01.57.01.18 0 .43-.07.67.51.24.58.83 2.02.9 2.17.07.15.12.32.02.52-.1.2-.15.32-.3.5-.15.17-.31.39-.44.52-.15.15-.3.31-.13.61.17.3.75 1.24 1.61 2.01 1.11.99 2.04 1.29 2.34 1.44.3.15.47.12.65-.07.17-.2.75-.87.95-1.17.2-.3.4-.25.67-.15.27.1 1.71.81 2 .96.3.15.5.22.57.35.07.12.07.72-.17 1.4Z"
      ></path>
    </svg>
    WhatsApp
  </a>

  <div class="flex gap-3 sm:contents">
    <a
      href={LINKS.strava}
      target="_blank"
      rel="noopener noreferrer"
      class:list={[base, sizes, secondary]}
    >
      <svg
        aria-hidden="true"
        class="size-5 shrink-0"
        viewBox="0 0 24 24"
        fill="currentColor"
      >
        <path
          d="M13.83 17.25 11.4 12.5H8.03L13.83 24l5.79-11.5h-3.36l-2.43 4.75ZM10.14 0 4.35 11.5h3.36L10.14 6.7l2.43 4.8h3.36L10.14 0Z"
        ></path>
      </svg>
      Strava
    </a>

    <a
      href={LINKS.instagram}
      target="_blank"
      rel="noopener noreferrer"
      class:list={[base, sizes, secondary]}
    >
      <svg
        aria-hidden="true"
        class="size-5 shrink-0"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      >
        <rect x="3" y="3" width="18" height="18" rx="5"></rect>
        <circle cx="12" cy="12" r="4"></circle>
        <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"></circle>
      </svg>
      Instagram
    </a>
  </div>
</div>
