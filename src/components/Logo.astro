---
import CatOnly from '@/assets/logos/cat-only.svg'
import CatBadge from '@/assets/logos/cat-logo.svg'
import Croissant from '@/assets/logos/croissant-logo.svg'

interface Props {
  /**
   * `cat` sólo la cara del tigre, `badge` el círculo con el texto,
   * `croissant` el lockup horizontal con el croissant corredor.
   */
  variant?: 'cat' | 'badge' | 'croissant'
  /** Si se pasa, el logo cuenta como imagen con nombre; si no, es decorativo */
  title?: string
  class?: string
}

const { variant = 'cat', title, class: className = '' } = Astro.props

const VARIANTS = { cat: CatOnly, badge: CatBadge, croissant: Croissant }
const Svg = VARIANTS[variant]
---

<!-- Los SVG traen `width`/`height` de Illustrator: `h-auto` deja que la altura
     la marque el viewBox cuando el ancho se fija por CSS. Los trazos usan
     `currentColor`, así que el color se hereda con `text-*`. -->
<Svg
  class:list={['h-auto', className]}
  role={title ? 'img' : undefined}
  aria-label={title}
  aria-hidden={title ? undefined : 'true'}
/>
