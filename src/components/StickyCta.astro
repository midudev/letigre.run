---
import { LINKS } from '@/consts'
---

{/* Barra fija en móvil: el CTA siempre a un pulgar de distancia */}
<div
  class="pointer-events-none fixed inset-x-0 bottom-0 z-50 p-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] transition-transform duration-300 data-[hidden]:translate-y-[130%] md:hidden"
  data-sticky-cta
  data-hidden
>
  <a
    href={LINKS.whatsapp}
    target="_blank"
    rel="noopener noreferrer"
    class="btn-brand-cta pointer-events-auto"
  >
    Únete al grupo
  </a>
</div>

<script>
  const cta = document.querySelector<HTMLElement>('[data-sticky-cta]')
  const hero = document.querySelector('header')

  if (cta && hero) {
    // Sólo aparece cuando el hero (que ya tiene sus propios botones) sale de pantalla
    new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) cta.setAttribute('data-hidden', '')
        else cta.removeAttribute('data-hidden')
      },
      { threshold: 0.15 }
    ).observe(hero)
  }
</script>
