---
import { CLUB } from '@/consts'
import HalftoneFade from '@/components/HalftoneFade.astro'
import Logo from '@/components/Logo.astro'
import NextRun from '@/components/NextRun.astro'
import SocialLinks from '@/components/SocialLinks.astro'
---

<header class="relative isolate min-h-[100svh] overflow-hidden pb-10">
  <!-- Fondo: la salida del sábado. El poster es el LCP, así que se pinta ya y
       el vídeo se descarga después sin competir con él. En móvil se sirve un
       archivo de menos de un mega. -->
  <video
    class="absolute inset-0 -z-20 size-full object-cover"
    poster="/videos/web/hero.webp"
    muted
    loop
    playsinline
    preload="none"
    aria-hidden="true"
    data-hero-video
  >
    <source
      src="/videos/web/hero-sm.webm"
      type="video/webm"
      media="(max-width: 640px)"
    />
    <source
      src="/videos/web/hero-sm.mp4"
      type="video/mp4"
      media="(max-width: 640px)"
    />
    <source src="/videos/web/hero.webm" type="video/webm" />
    <source src="/videos/web/hero.mp4" type="video/mp4" />
  </video>

  <!-- Velo suave: sólo el necesario para que el texto se lea sobre el vídeo -->
  <div
    aria-hidden="true"
    class="absolute inset-0 -z-10 bg-gradient-to-b from-ink-950/75 via-ink-950/35 to-transparent"
  >
  </div>
  <div
    aria-hidden="true"
    class="absolute inset-0 -z-10 bg-gradient-to-r from-ink-950/80 via-ink-950/25 to-transparent"
  >
  </div>

  <!-- El vídeo se disuelve en un tramado de puntos que crecen hasta el negro -->
  <HalftoneFade class="-z-10 h-[80%]" />

  <!-- Tigre gigante de fondo -->
  <Logo
    variant="cat"
    class="pointer-events-none absolute -top-10 -right-24 -z-10 w-[70vw] max-w-lg text-brand/10"
  />

  <div class="mx-auto flex min-h-[100svh] max-w-6xl flex-col px-5 pt-8">
    <Logo
      variant="croissant"
      title="Run with Le Tigre"
      class="w-52 text-brand sm:w-64"
    />

    <div class="flex flex-1 flex-col justify-center py-10">
      <h1 class="text-[15vw] leading-[0.85] sm:text-7xl lg:text-8xl">
        Corre,<br />
        <span class="text-brand">desayuna</span><br />
        y repite
      </h1>

      <p class="mt-6 max-w-lg text-lg/relaxed text-white/75">
        Club de running del <strong class="font-semibold text-white"
          >{CLUB.cityShort}</strong
        >. Nosotros ponemos el café y los croissants, y tú pones el running.
      </p>

      <!-- Redes a la izquierda, próxima salida al otro extremo de la misma línea -->
      <div
        class="mt-8 flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between lg:gap-10"
      >
        <SocialLinks />
        <NextRun alignEnd />
      </div>

      <!-- Datos clave de la salida. En móvil sólo caben dos columnas sin que
           "Sábados 8:00" parta en dos líneas: el precio es un guiño y se
           reserva para pantallas a partir de tablet. -->
      <dl
        class="mt-10 grid grid-cols-2 gap-4 border-t-2 border-brand/25 pt-5 sm:grid-cols-3"
      >
        <div>
          <dt class="text-xs tracking-wider text-white/50 uppercase">Cuándo</dt>
          <dd
            class="mt-1 font-display text-2xl text-brand sm:text-3xl"
            data-tabular
          >
            {CLUB.day} {CLUB.time}
          </dd>
        </div>
        <div>
          <dt class="text-xs tracking-wider text-white/50 uppercase">Ritmo</dt>
          <dd
            class="mt-1 font-display text-2xl text-brand sm:text-3xl"
            data-tabular
          >
            {CLUB.pace}
          </dd>
          <dd class="text-xs text-white/50">{CLUB.paceUnit}</dd>
        </div>
        <div class="hidden sm:block">
          <dt class="text-xs tracking-wider text-white/50 uppercase">Precio</dt>
          <dd class="mt-1 font-display text-2xl text-brand sm:text-3xl">0 €</dd>
          <dd class="text-xs text-white/50">café incluido</dd>
        </div>
      </dl>
    </div>
  </div>
</header>

<script>
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]')

  if (video) {
    const connection = (navigator as any).connection
    const savesData = connection?.saveData === true
    const slowNetwork = /^(slow-)?2g$/.test(connection?.effectiveType ?? '')
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches

    // Con ahorro de datos, red lenta o animaciones reducidas se queda el poster:
    // el hero se ve igual de bien y no se gastan megas a lo tonto
    if (!savesData && !slowNetwork && !reducedMotion) {
      // Se arranca tras el primer pintado para no competir con el LCP
      const start = () => {
        video.preload = 'auto'
        video.play().catch(() => {
          // Autoplay bloqueado: se queda el poster
        })
      }

      if ('requestIdleCallback' in window) {
        requestIdleCallback(start, { timeout: 2000 })
      } else {
        addEventListener('load', start, { once: true })
      }
    }

    // Un vídeo de fondo que sigue corriendo en una pestaña oculta sólo gasta batería
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) video.pause()
      else if (video.preload === 'auto') video.play().catch(() => {})
    })
  }
</script>
