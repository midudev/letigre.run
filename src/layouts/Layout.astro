---
import { Font } from "astro:assets"
import { COLORS, FAQ, LINKS, SITE, CLUB } from "@/consts"
import "@/styles/global.css"

interface Props {
  title?: string
  description?: string
}

const { title = SITE.title, description = SITE.description } = Astro.props

const canonical = new URL(Astro.url.pathname, Astro.site)

/** 1200×630: tamaño recomendado por Facebook/LinkedIn/X para previews */
const OG_IMAGE = {
  path: "/og.jpg",
  width: 1200,
  height: 630,
  type: "image/jpeg",
  alt: `El grupo de ${SITE.name} en la puerta de ${CLUB.meetingPoint}`,
} as const

const ogImageUrl = new URL(OG_IMAGE.path, Astro.site).href

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SportsClub",
      "@id": `${Astro.site}#club`,
      url: canonical.href,
      name: SITE.name,
      description: SITE.description,
      sport: "Running",
      image: {
        "@type": "ImageObject",
        url: ogImageUrl,
        width: OG_IMAGE.width,
        height: OG_IMAGE.height,
        encodingFormat: OG_IMAGE.type,
        caption: OG_IMAGE.alt,
      },
      address: {
        "@type": "PostalAddress",
        streetAddress: CLUB.street,
        postalCode: CLUB.postalCode,
        addressLocality: CLUB.city,
        addressCountry: "ES",
      },
      geo: {
        "@type": "GeoCoordinates",
        latitude: CLUB.coords.lat,
        longitude: CLUB.coords.lng,
      },
      // Los sábados a las 8:00, todas las semanas
      openingHoursSpecification: {
        "@type": "OpeningHoursSpecification",
        dayOfWeek: "https://schema.org/Saturday",
        opens: CLUB.time,
      },
      sameAs: [LINKS.instagram, LINKS.strava, LINKS.whatsapp],
    },
    {
      "@type": "WebSite",
      "@id": `${Astro.site}#website`,
      url: Astro.site?.href,
      name: SITE.name,
      description: SITE.description,
      inLanguage: "es-ES",
      publisher: { "@id": `${Astro.site}#club` },
      image: ogImageUrl,
    },
    {
      "@type": "WebPage",
      "@id": `${canonical.href}#webpage`,
      url: canonical.href,
      name: title,
      description,
      isPartOf: { "@id": `${Astro.site}#website` },
      about: { "@id": `${Astro.site}#club` },
      primaryImageOfPage: {
        "@type": "ImageObject",
        url: ogImageUrl,
        width: OG_IMAGE.width,
        height: OG_IMAGE.height,
      },
      inLanguage: "es-ES",
    },
    {
      "@type": "FAQPage",
      mainEntity: FAQ.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer },
      })),
    },
  ],
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content={COLORS.ink} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_ES" />

    {/* Imagen social absoluta: crawlers de WhatsApp, iMessage, X, LinkedIn… */}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content={OG_IMAGE.type} />
    <meta property="og:image:width" content={String(OG_IMAGE.width)} />
    <meta property="og:image:height" content={String(OG_IMAGE.height)} />
    <meta property="og:image:alt" content={OG_IMAGE.alt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={OG_IMAGE.alt} />

    {
      /* Anton = titulares del hero (font-display). Preload prioritario: sin él
         el H1 hace FOUT o retraso de pintura. Inter va sin preload a propósito
         para no competir en la ruta crítica con Anton ni con el póster. */
    }
    <Font cssVariable="--font-anton" preload />
    <Font cssVariable="--font-inter" />

    {
      /* El póster del vídeo del hero es el elemento más grande de la primera
         pantalla (el LCP): pedirlo cuanto antes adelanta el pintado */
    }
    <link
      rel="preload"
      as="image"
      href="/videos/web/hero.webp"
      type="image/webp"
      fetchpriority="high"
    />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />
  </head>
  <body class="antialiased">
    <slot />
  </body>
</html>
