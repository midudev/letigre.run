---
import { Font } from "astro:assets"
import { COLORS, FAQ, LINKS, SITE, CLUB } from "@/consts"
import "@/styles/global.css"

interface Props {
  title?: string
  description?: string
  /** Páginas que no deben indexarse (404): sin canonical ni datos estructurados */
  noindex?: boolean
}

const {
  title = SITE.title,
  description = SITE.description,
  noindex = false,
} = Astro.props

const canonical = new URL(Astro.url.pathname, Astro.site)

/** 1200×630: tamaño recomendado por Facebook/LinkedIn/X para previews */
const OG_IMAGE = {
  path: "/og.jpg",
  width: 1200,
  height: 630,
  type: "image/jpeg",
  alt: `El grupo de ${SITE.name} en la puerta de ${CLUB.meetingPoint}`,
} as const

const ogImageUrl = new URL(OG_IMAGE.path, Astro.site).href

/** Logo cuadrado para el panel de conocimiento de Google (mín. 112×112) */
const LOGO = { path: "/apple-touch-icon.png", width: 180, height: 180 } as const

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SportsClub",
      "@id": `${Astro.site}#club`,
      url: Astro.site?.href,
      name: SITE.name,
      alternateName: [SITE.legalName, SITE.shortName],
      description: SITE.description,
      sport: "Running",
      isAccessibleForFree: true,
      logo: {
        "@type": "ImageObject",
        url: new URL(LOGO.path, Astro.site).href,
        width: LOGO.width,
        height: LOGO.height,
      },
      image: {
        "@type": "ImageObject",
        url: ogImageUrl,
        width: OG_IMAGE.width,
        height: OG_IMAGE.height,
        encodingFormat: OG_IMAGE.type,
        caption: OG_IMAGE.alt,
      },
      address: {
        "@type": "PostalAddress",
        streetAddress: CLUB.street,
        postalCode: CLUB.postalCode,
        addressLocality: CLUB.city,
        addressCountry: "ES",
      },
      geo: {
        "@type": "GeoCoordinates",
        latitude: CLUB.coords.lat,
        longitude: CLUB.coords.lng,
      },
      hasMap: LINKS.maps,
      // Los sábados a las 8:00, todas las semanas
      openingHoursSpecification: {
        "@type": "OpeningHoursSpecification",
        dayOfWeek: "https://schema.org/Saturday",
        // schema.org Time: `hh:mm` con cero inicial (`8:00` no valida)
        opens: CLUB.time.padStart(5, "0"),
      },
      // Sólo perfiles públicos del club (el enlace de WhatsApp es una invitación)
      sameAs: [LINKS.instagram, LINKS.strava],
    },
    {
      "@type": "WebSite",
      "@id": `${Astro.site}#website`,
      url: Astro.site?.href,
      name: SITE.name,
      description: SITE.description,
      inLanguage: "es-ES",
      publisher: { "@id": `${Astro.site}#club` },
      image: ogImageUrl,
    },
    {
      "@type": "WebPage",
      "@id": `${canonical.href}#webpage`,
      url: canonical.href,
      name: title,
      description,
      isPartOf: { "@id": `${Astro.site}#website` },
      about: { "@id": `${Astro.site}#club` },
      primaryImageOfPage: {
        "@type": "ImageObject",
        url: ogImageUrl,
        width: OG_IMAGE.width,
        height: OG_IMAGE.height,
      },
      inLanguage: "es-ES",
    },
    {
      "@type": "FAQPage",
      mainEntity: FAQ.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer },
      })),
    },
  ],
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content={COLORS.ink} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {
      noindex ? (
        <meta name="robots" content="noindex, follow" />
      ) : (
        <>
          {/* Previews grandes en Discover / Imágenes y snippets sin límite */}
          <meta
            name="robots"
            content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
          />
          <link rel="canonical" href={canonical} />
          <meta property="og:url" content={canonical} />
        </>
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_ES" />

    {/* Imagen social absoluta: crawlers de WhatsApp, iMessage, X, LinkedIn… */}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content={OG_IMAGE.type} />
    <meta property="og:image:width" content={String(OG_IMAGE.width)} />
    <meta property="og:image:height" content={String(OG_IMAGE.height)} />
    <meta property="og:image:alt" content={OG_IMAGE.alt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={OG_IMAGE.alt} />

    {
      /* Anton = titulares del hero (font-display). Preload prioritario: sin él
         el H1 hace FOUT o retraso de pintura. Inter va sin preload a propósito
         para no competir en la ruta crítica con Anton ni con el póster. */
    }
    <Font cssVariable="--font-anton" preload />
    <Font cssVariable="--font-inter" />

    {/* Preloads propios de cada página (p. ej. el LCP de la home) */}
    <slot name="head" />

    {
      !noindex && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(structuredData)}
        />
      )
    }
  </head>
  <body class="antialiased">
    <slot />
  </body>
</html>
