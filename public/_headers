# Cabeceras para Cloudflare (Workers Assets / Pages)
#
# Importante (no se puede hacer desde este archivo):
# En Cloudflare → SSL/TLS → Edge Certificates → activa "Always Use HTTPS"
# para que http://letigre.run redirija 301 a https:// (Google lo necesita).
# Opcional: Redirect Rule www.letigre.run/* → https://letigre.run/$1 (301).

# HSTS: tras la 1.ª visita por HTTPS, el navegador solo usa HTTPS.
# No sustituye "Always Use HTTPS" para crawlers que aún pidan HTTP.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Todo lo que Astro genera lleva hash en el nombre: se puede cachear para siempre
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Los vídeos y sus pósters no llevan hash, pero cambian muy de vez en cuando
/videos/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Fotos preoptimizadas (AVIF/WebP/JPG): no llevan hash en el nombre
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Tarjeta social (og:image). Cache moderada: al cambiar de diseño conviene
# que los crawlers recojan la nueva sin esperar un año
/og.jpg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/*.webp
  Cache-Control: public, max-age=604800

/*.avif
  Cache-Control: public, max-age=604800

# El HTML tiene que revalidarse: la próxima salida se calcula en cliente, pero
# el resto del contenido sí cambia entre despliegues
/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate
